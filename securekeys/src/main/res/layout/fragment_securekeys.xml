<?xml version="1.0" encoding="utf-8"?>


<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin">


    <RelativeLayout
        android:id="@+id/rel_securekeys_pass_length"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txt_securekeys_pass_length_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/txt_securekeys_pass_length"
            android:gravity="center_vertical"
            android:text="@string/password_length" />

        <TextView
            android:id="@+id/txt_securekeys_pass_length"
            android:layout_width="@dimen/generate_button_height"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:gravity="center" />

        <SeekBar
            android:id="@+id/seek_securekeys_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/txt_securekeys_pass_length_title"
            android:layout_marginTop="8dp"
            android:max="25"
            android:progress="5" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/lin_securekeys_pass_params"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/chk_securekeys_case"
            style="@style/ParamCheckStyle"
            android:button="@drawable/btn_check_num" />

        <CheckBox
            android:id="@+id/chk_securekeys_char"
            style="@style/ParamCheckStyle"
            android:button="@drawable/btn_check_case" />

        <CheckBox
            android:id="@+id/chk_securekeys_num"
            style="@style/ParamCheckStyle"
            android:button="@drawable/btn_check_char" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/rel_securekeys_passphrase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:focusable="true"
        android:focusableInTouchMode="true">


        <EditText
            android:id="@+id/edt_securekeys_passphrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@+id/imb_securekeys_generate"
            android:layout_alignTop="@+id/imb_securekeys_generate"
            android:layout_marginBottom="1dp"
            android:layout_marginRight="24dp"
            android:layout_marginTop="1dp"
            android:layout_toRightOf="@+id/chk_securekeys_mask"
            android:background="@color/edt_bg_color"
            android:gravity="center"
            android:hint="@string/enter_pass_hint"
            android:imeOptions="actionGo"
            android:minHeight="@dimen/generate_button_height"
            android:paddingLeft="@dimen/balancing_padding"
            android:paddingRight="@dimen/generate_button_height"
            android:singleLine="true"
            android:textColor="@color/edt_color"
            android:textColorHint="@color/edt_hint_color"
            android:textSize="@dimen/text_medium" />

        <CheckBox
            android:id="@+id/chk_securekeys_mask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@+id/edt_securekeys_passphrase"
            android:layout_alignTop="@+id/edt_securekeys_passphrase"
            android:background="@color/edt_bg_color"
            android:button="@drawable/ic_launcher" />

        <ImageButton
            android:id="@+id/imb_securekeys_generate"
            android:layout_width="@dimen/generate_button_height"
            android:layout_height="@dimen/generate_button_height"
            android:layout_alignParentRight="true"
            android:background="@drawable/btn_generate"
            android:src="@drawable/ic_go" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rel_securekeys_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txt_securekeys_passphrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:marqueeRepeatLimit="marquee_forever"
            android:padding="4dp"
            android:scrollHorizontally="true"
            android:textSize="@dimen/passphrase_text_size" />


        <TextView
            android:id="@+id/txt_securekeys_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@+id/imb_securekeys_reset"
            android:layout_alignTop="@+id/imb_securekeys_reset"
            android:layout_marginBottom="1dp"
            android:layout_marginRight="24dp"
            android:layout_marginTop="1dp"
            android:background="@color/edt_bg_color"
            android:gravity="center"
            android:minHeight="@dimen/generate_button_height"
            android:paddingLeft="@dimen/balancing_padding"
            android:paddingRight="@dimen/generate_button_height"
            android:singleLine="true"
            android:textColor="@color/edt_color"
            android:textColorHint="@color/edt_hint_color"
            android:textIsSelectable="true"
            android:textSize="@dimen/text_medium" />

        <ImageButton
            android:id="@+id/imb_securekeys_reset"
            android:layout_width="@dimen/generate_button_height"
            android:layout_height="@dimen/generate_button_height"
            android:layout_alignParentRight="true"
            android:layout_below="@+id/txt_securekeys_passphrase"
            android:background="@drawable/btn_generate"
            android:src="@drawable/ic_go" />

    </RelativeLayout>

</LinearLayout>
