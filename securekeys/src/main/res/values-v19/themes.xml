<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="SecureKeys.Light" parent="Theme.AppCompat.Light">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:buttonStyle">@style/DefaultButton</item>
        <item name="android:windowBackground">@null</item>
        <item name="actionBarStyle">@style/SecureKeysActionBarStyle</item>
        <item name="android:actionBarStyle">@style/SecureKeysActionBarStyle</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:fitsSystemWindows">false</item>
    </style>

    <style name="SecureKeys.Dark" parent="Theme.AppCompat">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:buttonStyle">@style/DefaultButton</item>
        <item name="android:windowBackground">@null</item>
        <item name="actionBarStyle">@style/SecureKeysActionBarStyle.Dark</item>
        <item name="android:actionBarStyle">@style/SecureKeysActionBarStyle.Dark</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:fitsSystemWindows">false</item>
    </style>
</resources>